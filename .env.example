# Copy to .env (git-ignored) and fill in. Never commit real keys.
# Values are the PRD's proposed defaults; internal/config owns the final list.

# --- Logging ---
# slog level: debug, info, warn, error.
LOG_LEVEL=info

# --- HTTP (cmd/api) ---
# Public listener.
HTTP_ADDR=:8080
# pprof and the goroutineleak profile; must be a loopback address.
DEBUG_ADDR=127.0.0.1:6060
# Comma-separated CIDRs (a bare IP is one host) whose X-Forwarded-For is trusted;
# empty means use RemoteAddr only.
TRUSTED_PROXIES=
# http.Server timeouts: request header, whole request, keep-alive idle.
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_IDLE_TIMEOUT=60s
# Per-request write deadline of non-streaming handlers (no server-wide
# WriteTimeout, it would cut SSE streams).
HTTP_WRITE_TIMEOUT=10s

# --- Postgres ---
# pgx connection string.
DATABASE_URL=postgres://triage:triage@localhost:5432/triage?sslmode=disable

# --- Kafka ---
# Comma-separated bootstrap brokers reachable from the host.
KAFKA_BROKERS=localhost:29092
# Consumer group of the classifier workers.
KAFKA_CONSUMER_GROUP=triage-workers

# --- Outbox relay (cmd/api) ---
# Wait between polls once the outbox is drained.
OUTBOX_POLL_INTERVAL=500ms
# Max outbox rows claimed and published per transaction.
OUTBOX_BATCH_SIZE=100
# Max wait for the broker to acknowledge one batch; unacknowledged rows stay unpublished.
OUTBOX_PUBLISH_TIMEOUT=10s
# How long published rows are kept, and how often older ones are deleted.
OUTBOX_RETENTION=168h
OUTBOX_CLEANUP_INTERVAL=1h

# --- Classifier ---
# fake (deterministic keyword classifier, no key needed) or jev.
CLASSIFIER=fake
# Jev provider when CLASSIFIER=jev: openrouter or typesafe.
JEV_PROVIDER=openrouter
# OpenRouter API key (secret; only in .env).
OPENROUTER_API_KEY=
# Direct TypeSafe API key, used when JEV_PROVIDER=typesafe (secret; only in .env).
TYPESAFE_API_KEY=
# Pinned Jev model, in OpenRouter naming; it serves the snapshot typesafe/jev-1.14-20261014.
# ~typesafe/jev-latest is the moving alias. typesafe/jev-router is a chat model, not Jev System One.
JEV_MODEL=typesafe/jev-1.14
# Per-call timeout.
JEV_TIMEOUT=3s
# Client-side rate limit (requests per second), set below the org limit.
JEV_RATE_LIMIT=5
# Max concurrent Jev calls per worker.
JEV_MAX_CONCURRENCY=8
# Input price in USD per 1M tokens, used when the response reports no cost.
JEV_INPUT_PRICE_PER_MTOK_USD=0.042
# Daily Jev spend cap in USD (UTC day); once spent, tickets go to needs_human.
DAILY_BUDGET_USD=1.00

# --- Thresholds ---
# Category confidence below this goes to needs_human (low_confidence).
CATEGORY_MIN_CONFIDENCE=0.60
# Urgency confidence below this goes to needs_human (low_confidence).
URGENCY_MIN_CONFIDENCE=0.50
# P(complaint) inside [low, high] flags complaint_uncertain; status unchanged.
COMPLAINT_UNCERTAIN_LOW=0.35
COMPLAINT_UNCERTAIN_HIGH=0.65
# Send category=other to needs_human (category_other).
ROUTE_OTHER_TO_HUMAN=true

# --- Limits ---
# Per-IP submit rate limit: tokens per minute and burst.
SUBMIT_RATE_PER_MIN=5
SUBMIT_BURST=3
# Per-IP stream-token minting rate limit: tokens per minute and burst.
STREAM_TOKEN_RATE_PER_MIN=10
STREAM_TOKEN_BURST=3
# Max request body size in bytes (413 above it).
MAX_BODY_BYTES=16384
# Max pending tickets before POST /tickets answers 503.
PENDING_CAP=1000
# Stream token lifetime.
STREAM_TOKEN_TTL=60s
# SSE connections per client IP (429) and per instance (503).
SSE_MAX_PER_IP=5
SSE_MAX_GLOBAL=1000
# Max SSE stream duration and heartbeat interval.
SSE_MAX_DURATION=10m
SSE_HEARTBEAT=15s
